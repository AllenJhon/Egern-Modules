#!name = 腾讯视频净化
#!desc = Loon 原生版 v3：以 QX 插件效果图为目标，v2 基础上加补推广素材域 REJECT。QX 二进制脚本在 Loon 里因 bodyBytes 不可用而无效，详情页信息流卡片、个人中心横幅若嵌在主数据里，本版仍可能去不掉，需实机测试确认。
#!author = TG@ZenMoFiShi, RuCu6, LinusZ
#!system = ios

[Rule]
DOMAIN-SUFFIX,iacc.stgw.qq.com,REJECT
DOMAIN-SUFFIX,tacc.video.qq.com,REJECT
DOMAIN,adsmind.gdtimg.com,REJECT
DOMAIN,info4.video.qq.com,REJECT
DOMAIN,info6.video.qq.com,REJECT
DOMAIN,ios.video.mpush.qq.com,REJECT
DOMAIN,otheve.beacon.qq.com,REJECT
DOMAIN,pgdt.gtimg.cn,REJECT
DOMAIN,tpns.qq.com,REJECT
DOMAIN,vv6.video.qq.com,REJECT
DOMAIN,btrace.video.qq.com,REJECT
DOMAIN,activity.video.qq.com,REJECT
DOMAIN,ugchsy.gtimg.com,REJECT
DOMAIN,rpt.gdt.qq.com,REJECT
DOMAIN,v3.gdt.qq.com,REJECT
DOMAIN,xs.gdt.qq.com,REJECT
DOMAIN,aegis.qq.com,REJECT
DOMAIN,rmonitor.qq.com,REJECT
DOMAIN,tux.qq.com,REJECT
DOMAIN,p.l.qq.com,REJECT
DOMAIN,p2.l.qq.com,REJECT
DOMAIN,wallpaper-1258344696.file.myqcloud.com,REJECT
DOMAIN,wallpaper-test-1258344696.file.myqcloud.com,REJECT
DOMAIN-SUFFIX,gdt.qq.com,REJECT
DOMAIN-SUFFIX,l.qq.com,REJECT
DOMAIN-SUFFIX,tetrack.qq.com,REJECT
DOMAIN-SUFFIX,tpns.tencent.com,REJECT
DOMAIN-SUFFIX,stat.tpns.tencent.com,REJECT
DOMAIN-SUFFIX,api.poll.video.qq.com,REJECT
DOMAIN-KEYWORD,trace.qq.com,REJECT
DOMAIN-KEYWORD,trace.video.qq.com,REJECT
IP-CIDR,47.110.187.87/32,REJECT,no-resolve
URL-REGEX,^http:\/\/[\d\.:]*\/?(defaultts\.tc|vmind\.qqvideo\.tc|finderpdd\.video)\.qq\.com\/\w+,REJECT
URL-REGEX,^http:\/\/apd-vlive\.apdcdn\.tc\.qq\.com\/vmind\.qqvideo\.tc\.qq\.com\/\w+,REJECT
URL-REGEX,^http:\/\/apd-\w+\.v\.smtcdns\.com\/(defaultts|omts|vmind\.qqvideo)\.tc\.qq\.com\/\w+,REJECT

[Rewrite]
^https?:\/\/vv\.video\.qq\.com\/(diff|get)vmind reject-dict

[Script]
http-request ^https?:\/\/vv\.video\.qq\.com\/getvinfo script-path=https://raw.githubusercontent.com/linuszlx/JS/main/replace-body.js, requires-body=true, argument=&sppreviewtype=\d(.*)&spsrt=\d->&sppreviewtype=0$1&spsrt=0, tag=移除贴片广告
http-response ^https:\/\/rdelivery\.qq\.com\/v1\/sdkconfig\/get(?:\?.*)?$ script-path=https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/Txvideoad.js, requires-body=true, tag=腾讯视频净化-tab

[Mitm]
hostname = vv.video.qq.com, rdelivery.qq.comi，video.qq.com, iacc.qq.com, config.ab.qq.com
